@model VehicleListViewModel
@{
    ViewData["Title"] = "Araçlar";
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Araçlar</h3>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Araç</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="plate" value="@Model.PlateSearch" class="form-control" placeholder="Plaka ara..." />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select"

@*         enum’daki [Display(Name = "Binek")] isimlerini kullanarak dropdown seçeneklerini otomatik üretir.
 *@                
                asp-items="Html.GetEnumSelectList<VehicleType>()">
            <option value="">Tüm araç tipleri</option>
        </select>
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
        <a asp-action="Index" class="btn btn-link">Temizle</a>
    </div>
</form>

@if (!Model.Vehicles.Any())
{
    <div class="alert alert-info">Kayıtlı araç bulunamadı.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Plaka</th>
                    <th>Araç Tipi</th>
                    <th>Marka / Model</th>
                    <th>Ruhsat Seri No</th>
                    <th>Tescil Tarihi</th>
                    @if (isAdmin)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td class="fw-semibold">@vehicle.VehiclePlate</td>
                        <td>@vehicle.VehicleType.GetDisplayName()</td>
                        <td>@vehicle.VehicleBrand @vehicle.VehicleModel</td>
                        <td>@(vehicle.VehicleLicenceSerialNo ?? "-")</td>
                        <td>@(vehicle.VehicleRegistrationDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@vehicle.VehicleId"
                                   class="btn btn-sm btn-outline-primary">Düzenle</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}