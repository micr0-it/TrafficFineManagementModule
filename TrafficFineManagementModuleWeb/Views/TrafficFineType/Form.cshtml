@model TrafficFineTypeFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Ceza Türü Düzenle" : "Yeni Ceza Türü";
}

<h3 class="mb-3">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">
            <input type="hidden" asp-for="TrafficFineTypeId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Article" class="form-label"></label>
                <input asp-for="Article" class="form-control" placeholder="KTK 47/1-b" />
                <span asp-validation-for="Article" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" placeholder="Kırmızı ışıkta geçmek" />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TrafficFinePoint" class="form-label"></label>
                    <input asp-for="TrafficFinePoint" type="number" min="0" max="100" class="form-control" />
                    <span asp-validation-for="TrafficFinePoint" class="text-danger small"></span>
                </div>
            </div>

            @if (Model.IsEdit)
            {
                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="IsActive" />
            }

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
