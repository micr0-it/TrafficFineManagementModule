@model TrafficFineListViewModel
@{
    ViewData["Title"] = "Tüm Cezalar";
}

<h3 class="mb-3">Tüm Cezalar</h3>

<form asp-action="Index" method="get" class="card card-body mb-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label asp-for="SearchText" class="form-label small"></label>
            <input asp-for="SearchText" class="form-control" placeholder="Tutanak no veya plaka" />
        </div>
        <div class="col-md-2">
            <label asp-for="Status" class="form-label small"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ApprovalStatus>()" class="form-select">
                <option value="">Tümü</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="VehicleType" class="form-label small"></label>
            <select asp-for="VehicleType" asp-items="Html.GetEnumSelectList<VehicleType>()" class="form-select">
                <option value="">Tümü</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="DateFrom" class="form-label small"></label>
            <input asp-for="DateFrom" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="DateTo" class="form-label small"></label>
            <input asp-for="DateTo" class="form-control" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
        </div>
    </div>
    <div class="mt-2">
        <a asp-action="Index" class="small">Filtreleri temizle</a>
    </div>
</form>

@if (!Model.Fines.Any())
{
    <div class="alert alert-info">Kriterlere uyan ceza bulunamadı.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Tutanak No</th>
                    <th>Ceza Tarihi</th>
                    <th>Plaka</th>
                    <th>Araç Tipi</th>
                    <th>Ceza Türü</th>
                    <th>Sürücü</th>
                    <th class="text-end">Tutar</th>
                    <th>Durum</th>
                    <th>Giren</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fine in Model.Fines)
                {
                    <tr>
                        <td class="fw-semibold">@fine.TrafficFineRecordNo</td>
                        <td>@fine.TrafficFineDate.ToDateTime()</td>
                        <td>@fine.Vehicle.VehiclePlate</td>
                        <td>@fine.Vehicle.VehicleType.GetDisplayName()</td>
                        <td title="@fine.TrafficFineType.Description">@fine.TrafficFineType.Article</td>
                        <td>@(fine.Driver?.DriverNameSurname ?? "-")</td>
                        <td class="text-end">@fine.TrafficFineAmount.ToMoney()</td>
                        <td><partial name="_ApprovalStatusBadge" model="fine.ApprovalStatus" /></td>
                        <td>@fine.RecordedByPersonnel.NameSurname</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="6">@Model.Fines.Count kayıt</td>
                    <td class="text-end">@Model.TotalAmount.ToMoney()</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}