@{
    var code = ViewData["StatusCode"] as int? ?? 0;

    var (title, message) = code switch
    {
        404 => ("Sayfa bulunamadı", "Aradığınız sayfa veya kayıt mevcut değil ya da silinmiş olabilir."),
        400 => ("Geçersiz istek", "Gönderilen bilgiler işlenemedi. Lütfen sayfayı yenileyip tekrar deneyin."),
        403 => ("Erişim engellendi", "Bu işlem için yetkiniz bulunmuyor."),
        _ => ("Bir sorun oluştu", "İsteğiniz işlenirken bir sorun oluştu.")
    };

    ViewData["Title"] = title;
}

<div class="text-center mt-5">
    <div class="display-4 text-muted mb-2">@code</div>
    <h3>@title</h3>
    <p class="text-muted">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Ana Sayfaya Dön</a>
</div>