@model IEnumerable<TrafficFineApprovalHistory>

<div class="card mt-3">
    <div class="card-header fw-semibold">Onay Geçmişi</div>

    @if (!Model.Any())
    {
        <div class="card-body text-muted">Bu ceza için işlem kaydı bulunmuyor.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>İşlem</th>
                        <th>Kullanıcı</th>
                        <th>Durum Değişimi</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    @*OrderBy sadece güvence, partial başka bir yerden sırasız bir listeyle çağrılırsa da doğru görünsün diye.*@
                    @foreach (var history in Model.OrderBy(h => h.ActionDate))
                    {
                        var actionCss = history.ActionType switch
                        {
                            ApprovalActionType.Created => "text-secondary",
                            ApprovalActionType.Submitted => "text-primary",
                            ApprovalActionType.Approved => "text-success",
                            ApprovalActionType.Rejected => "text-danger",
                            _ => ""
                        };

                        <tr class="@(history.ActionType == ApprovalActionType.Rejected ? "table-danger" : "")">
                            <td class="text-nowrap">@history.ActionDate.ToDateTime()</td>
                            <td class="fw-semibold @actionCss">@history.ActionType.GetDisplayName()</td>
                            <td>
                                @history.PerformedByUser.NameSurname
                                <div class="text-muted small">@history.PerformedByUser.Role.GetDisplayName()</div>
                            </td>
                            <td class="text-nowrap">
                                @if (history.PreviousStatus is not null)
                                {
                                    <partial name="_ApprovalStatusBadge" model="history.PreviousStatus.Value" />
                                    <span class="mx-1">→</span>
                                }
                                <partial name="_ApprovalStatusBadge" model="history.NewStatus" />
                            </td>
                            <td>@(history.Description ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>