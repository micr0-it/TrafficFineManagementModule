<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrafficFineManagementModuleWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrafficFineManagementModuleWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Trafik Cezası Yönetimi</a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç/kapat">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="TrafficFine" asp-action="Index">Tüm Cezalar</a>
                    </li>

                    @if (User.IsInRole(nameof(UserRole.Personnel)))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="TrafficFine" asp-action="MyFines">Cezalarım</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="TrafficFine" asp-action="Create">Yeni Ceza</a>
                        </li>
                    }

                    @if (User.IsInRole(nameof(UserRole.Manager)) || User.IsInRole(nameof(UserRole.Finance)))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="TrafficFine" asp-action="Pending">Bekleyen İşlerim</a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Vehicle" asp-action="Index">Araçlar</a>
                    </li>

                    @if (User.IsInRole(nameof(UserRole.Admin)))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Tanımlar</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="TrafficFineType" asp-action="Index">Ceza Türleri</a></li>
                                <li><a class="dropdown-item" asp-controller="Driver" asp-action="Index">Sürücüler</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="AppUser" asp-action="Index">Kullanıcılar</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <span class="navbar-text">
                        @User.GetNameSurname()
                        <span class="badge bg-secondary">@User.GetUserRole().GetDisplayName()</span>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Çıkış</button>
                    </form>
                </div>
            </div>
        }
    </div>
</nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
