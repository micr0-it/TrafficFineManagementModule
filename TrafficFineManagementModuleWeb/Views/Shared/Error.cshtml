@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center mt-5">
    <h3>Beklenmeyen bir hata oluştu</h3>
    <p class="text-muted">
        İşleminiz sırasında bir sorun oluştu. Lütfen tekrar deneyin;
        sorun devam ederse sistem yöneticisine başvurun.
    </p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">
            Hata kodu: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Ana Sayfaya Dön</a>
</div>